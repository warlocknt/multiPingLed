    object SettingsTab: TTabSheet
      Caption = 'Settings'
      ClientHeight = 281
      ClientWidth = 692
      object cbSelectLanguage: TComboBox
        Left = 8
        Height = 21
        Top = 25
        Width = 100
        ItemHeight = 15
        Items.Strings = (
          'English'
          'Russian'
        )
        Style = csOwnerDrawFixed
        TabOrder = 0
        OnChange = cbSelectLanguageChange
      end
      object lLang: TLabel
        Left = 32
        Height = 15
        Top = 8
        Width = 55
        Caption = 'Language:'
      end
      object lCommandExec: TLabel
        Left = 221
        Height = 15
        Top = 58
        Width = 267
        Caption = 'Command for the selected node on status change:'
      end
      object eCommandExec: TEdit
        Left = 205
        Height = 23
        Top = 74
        Width = 352
        TabOrder = 1
        TextHint = 'C:\\\\notify.cmd host=\\{host\\} status=\\{status\\} ping=\\{ping\\}'
      end
      object Memo1: TMemo
        Left = 224
        Height = 90
        Top = 102
        Width = 335
        BorderStyle = bsNone
        Lines.Strings = (
          '{host}'#9'IP address or DNS name'
          '{name}'#9'Node name'
          '{status}'#9'up / down'
          '{group}'#9'Group name'
          '{ping}'#9'Response time (ms)'
        )
        ReadOnly = True
        TabOrder = 2
      end
      object cbBaloonHint: TCheckBox
        Left = 211
        Height = 19
        Top = 25
        Width = 276
        Caption = 'Notify on node status change with a balloon hint'
        TabOrder = 3
      end
      object cbLogging: TCheckBox
        Left = 8
        Height = 19
        Top = 202
        Width = 129
        Caption = 'Write diagnostic logs'
        TabOrder = 4
        OnChange = DiagnosticsChanged
      end
      object cbPingComparison: TCheckBox
        Left = 8
        Height = 19
        Top = 224
        Width = 257
        Caption = 'Compare with system ping (requires logging)'
        TabOrder = 5
        OnChange = DiagnosticsChanged
      end
      object cbSessionReport: TCheckBox
        Left = 8
        Height = 19
        Top = 246
        Width = 220
        Caption = 'Create and open session report on exit'
        TabOrder = 6
        OnChange = DiagnosticsChanged
      end
