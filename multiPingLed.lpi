      <StringTable Comments="lightweight Windows tray utility for monitoring multiple hosts via ICMP (ping) with LED-style status indicators" FileDescription="lightweight Windows tray utility for monitoring multiple hosts via ICMP (ping) with LED-style status indicators" InternalName="multiPingLed" OriginalFilename="multiPingLed.exe" ProductName="multiPingLed" ProductVersion="1.2.0.8"/>
